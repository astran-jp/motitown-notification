    {"rect": [152, 252, 752, 382], "fill": null, "text": "Welcome to Motitown!\nHere, the hard work you share with friends\nearns you real status and honor!", "size": 27, "weight": 800, "color": "#1d4b57", "line_height": 1.5},
    {"rect": [150, 250, 750, 380], "fill": null, "text": "Welcome to Motitown!\nHere, the hard work you share with friends\nearns you real status and honor!", "size": 27, "weight": 800, "color": "#ffffff", "line_height": 1.5},
    {"rect": [230, 1415, 670, 1493], "fill": "auto", "text": "What is the Citizen League?", "size": 60, "weight": 800, "color": {"darkest": [240, 1420, 660, 1488]}, "box": [50, 1411, 850, 1471], "line_height": 1.0},
    {"rect": [55, 1518, 845, 1770], "fill": "auto", "text": "It's a weekly event where your hard work at learning gets the recognition it deserves! Learn alongside your friends, and finish high in your league to raise your Citizen Rank. Reach \"Legend\" or the \"Divine Realm\" and make a name for yourself in Motitown!", "size": 32, "weight": 500, "color": {"darkest": [60, 1520, 840, 1750]}, "box": [50, 1512, 850, 1755], "line_height": 1.45},
    {"rect": [250, 1866, 655, 1918], "fill": "auto", "text": "See how the league works >", "size": 40, "weight": 800, "color": {"darkest": [255, 1870, 650, 1915]}, "box": [150, 1864, 750, 1904], "line_height": 1.0}
  ],
