{
  "assets/01-883b706e-1.webp": [
    {"rect": [225, 82, 820, 162], "fill": "auto", "text": "Start by Speaking English!", "size": 56, "weight": 800, "align": "left", "box": [235, 82, 820, 162], "color": {"darkest": [240, 95, 780, 150]}},
    {"rect": [400, 318, 845, 530], "fill": "auto", "text": "Motispi has two conversation modes: Free Talk and Roleplay.", "size": 34, "weight": 500, "align": "left", "box": [410, 318, 840, 530], "color": {"darkest": [415, 330, 830, 520]}, "line_height": 1.45, "valign": "top"},
    {"rect": [400, 560, 845, 820], "fill": "auto", "text": "The fastest way to become a confident English speaker is simply to speak a lot. So first, talk with your teacher as much as you can!", "size": 34, "weight": 500, "align": "left", "box": [410, 560, 840, 820], "color": {"darkest": [415, 575, 830, 805]}, "line_height": 1.45, "valign": "top"},
    {"rect": [50, 962, 490, 1052], "fill": "auto", "text": "Free Talk", "size": 56, "weight": 800, "align": "left", "box": [58, 962, 490, 1052], "color": {"darkest": [60, 975, 340, 1040]}},
    {"rect": [50, 1070, 475, 1372], "fill": "auto", "text": "In Free Talk, you enjoy a free-flowing conversation on a theme. Pick any theme you like, or let your teacher suggest one for today.", "size": 33, "weight": 500, "align": "left", "box": [58, 1070, 470, 1372], "color": {"darkest": [60, 1085, 430, 1355]}, "line_height": 1.45},
    {"rect": [50, 1718, 490, 1802], "fill": "auto", "text": "Roleplay", "size": 56, "weight": 800, "align": "left", "box": [58, 1718, 490, 1802], "color": {"darkest": [60, 1730, 340, 1790]}},
    {"rect": [50, 1818, 475, 1861], "fill": "auto", "text": "In Roleplay, you learn the English", "size": 33, "weight": 500, "align": "left", "box": [58, 1820, 470, 1861], "color": {"darkest": [60, 1085, 430, 1355]}, "valign": "top", "line_height": 1.25}
  ],
  "assets/01-883b706e-2.webp": [
    {"rect": [50, 0, 475, 108], "fill": "auto", "text": "you'd actually use in real-life scenes and situations.", "size": 33, "weight": 500, "align": "left", "box": [58, 4, 470, 108], "color": {"darkest": [60, 175, 430, 390]}, "valign": "top", "line_height": 1.45},
    {"rect": [50, 155, 475, 405], "fill": "auto", "text": "There are over 1,500 scenes, like ordering at a cafe, introducing yourself at a new job, or acing an interview in English.", "size": 33, "weight": 500, "align": "left", "box": [58, 155, 470, 405], "color": {"darkest": [60, 175, 430, 390]}, "line_height": 1.45},
    {"rect": [50, 672, 845, 882], "fill": "auto", "text": "If you've just installed Motispi, dive into Free Talk and Roleplay, whichever you like, and talk as much as you can! The more you speak, the better you'll get.", "size": 34, "weight": 500, "align": "left", "box": [58, 672, 840, 882], "color": {"darkest": [60, 690, 830, 870]}, "line_height": 1.45},
    {"rect": [50, 912, 845, 1078], "fill": "auto", "text": "Motispi covers everything from absolute beginner to native level, so anyone can start with confidence.", "size": 34, "weight": 500, "align": "left", "box": [58, 912, 840, 1078], "color": {"darkest": [60, 930, 830, 1065]}, "line_height": 1.45},
    {"rect": [50, 1112, 475, 1432], "fill": "auto", "text": "Plus, the Analysis Report automatically sorts the phrases and words you used well, and the ones you should learn next.", "size": 33, "weight": 500, "align": "left", "box": [58, 1112, 470, 1432], "color": {"darkest": [60, 1130, 430, 1420]}, "line_height": 1.45},
    {"rect": [50, 1468, 475, 1782], "fill": "auto", "text": "Those phrases and words go straight into your Phrasebook and Wordbook, so you can memorize them in Adventure Mode or in Motitan!", "size": 33, "weight": 500, "align": "left", "box": [58, 1468, 470, 1782], "color": {"darkest": [60, 1485, 430, 1770]}, "line_height": 1.45}
  ],
